/* pages/member/member.wxss */

.member-page {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background: #F8FAFF;
}

/* ========== 会员头部横幅 ========== */
.member-header {
  position: relative;
  margin-bottom: 48rpx;
  overflow: hidden;
}

.header-bg {
  height: 420rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
  position: relative;
  overflow: hidden;
}

/* 光晕装饰 */
.header-bg::before {
  content: '';
  position: absolute;
  top: -120rpx;
  left: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -100rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
}

.header-content {
  position: absolute;
  top: 100rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #FFFFFF;
  z-index: 2;
}

.vip-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(230, 81, 0, 0.4));
}

.vip-title {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title-main {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(230, 81, 0, 0.3);
}

.title-sub {
  font-size: 26rpx;
  opacity: 0.92;
  letter-spacing: 2rpx;
}

/* ========== 特权总览 ========== */
.privilege-overview {
  position: absolute;
  bottom: -48rpx;
  left: 28rpx;
  right: 28rpx;
  display: flex;
  justify-content: space-around;
  padding: 32rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  z-index: 3;
}

.privilege-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.privilege-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.privilege-text {
  font-size: 22rpx;
  color: #5A6A8A;
  font-weight: 500;
}

/* ========== 通用section ========== */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 24rpx;
  padding: 0 28rpx;
  position: relative;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  border-radius: 4rpx;
  margin-right: 16rpx;
  vertical-align: middle;
}

/* ========== 套餐选择 ========== */
.plan-section {
  padding: 88rpx 24rpx 32rpx;
}

.plan-list {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.plan-card {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 16rpx 32rpx;
  background-color: #FFFFFF;
  border: 2rpx solid #E8ECF5;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.06);
  transition: all 0.3s ease;
}

.plan-card.selected {
  border: 2rpx solid transparent;
  background: linear-gradient(#FFFFFF, #FFFFFF) padding-box,
              linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%) border-box;
  box-shadow: 0 12rpx 40rpx rgba(255, 179, 71, 0.25);
  transform: translateY(-4rpx);
}

.plan-card.popular {
  border: 2rpx solid transparent;
  background: linear-gradient(#FFFFFF, #FFFFFF) padding-box,
              linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%) border-box;
  transform: scale(1.03);
  box-shadow: 0 12rpx 40rpx rgba(255, 179, 71, 0.2);
}

.plan-tag {
  position: absolute;
  top: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 24rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 71, 0.35);
  letter-spacing: 1rpx;
}

.plan-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.plan-price {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.price-symbol {
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.price-value {
  font-size: 56rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
}

.plan-duration {
  font-size: 24rpx;
  color: #5A6A8A;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.plan-original {
  font-size: 22rpx;
  color: #8B9AB8;
  text-decoration: line-through;
}

/* ========== 权益列表 ========== */
.plan-features {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-check {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 16rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
}

.feature-text {
  font-size: 28rpx;
  color: #1A2240;
  font-weight: 500;
  flex: 1;
}

/* ========== 立即开通按钮 ========== */
.buy-btn {
  height: 100rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 179, 71, 0.45);
  letter-spacing: 4rpx;
  margin: 0 24rpx 32rpx;
}

.buy-btn::after {
  border: none;
}

/* ========== 权益对比 ========== */
.benefit-section {
  padding: 0 24rpx;
  margin-bottom: 40rpx;
}

.benefit-table {
  padding: 0;
  overflow: hidden;
  border-radius: 28rpx;
  background-color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.table-header {
  display: flex;
  padding: 24rpx 20rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  font-weight: 600;
  font-size: 26rpx;
  color: #FFFFFF;
}

.table-body {
  display: flex;
  flex-direction: column;
}

.table-row {
  display: flex;
  padding: 24rpx 20rpx;
  border-top: 2rpx solid #F0F3FA;
  font-size: 26rpx;
  background-color: #FFFFFF;
}

.col-name {
  flex: 1.2;
  color: #5A6A8A;
  font-weight: 500;
}

.col-free {
  flex: 1;
  color: #8B9AB8;
  text-align: center;
}

.col-vip {
  flex: 1;
  color: #FFB347;
  text-align: center;
  font-weight: 600;
}

.vip-check {
  color: #FFB347;
  margin-right: 4rpx;
}

.table-header .col-name,
.table-header .col-free,
.table-header .col-vip {
  color: #FFFFFF;
  font-weight: 600;
}

/* ========== 用户评价 ========== */
.review-section {
  padding: 0 24rpx;
  margin-bottom: 40rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.review-card {
  margin-bottom: 0;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.06);
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.review-user {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.user-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2240;
}

.review-rating {
  font-size: 24rpx;
  color: #FFB347;
}

.star {
  margin-left: 2rpx;
}

.review-content {
  font-size: 26rpx;
  color: #5A6A8A;
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.review-time {
  font-size: 22rpx;
  color: #8B9AB8;
}

/* ========== FAQ ========== */
.faq-section {
  padding: 0 24rpx;
  margin-bottom: 40rpx;
}

.faq-list {
  padding: 0;
  overflow: hidden;
  border-radius: 28rpx;
  background-color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.06);
}

.faq-item {
  padding: 28rpx;
  border-bottom: 2rpx solid #F0F3FA;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.question-text {
  font-size: 28rpx;
  color: #1A2240;
  font-weight: 600;
  flex: 1;
}

.question-arrow {
  font-size: 32rpx;
  color: #8B9AB8;
  transition: transform 0.3s ease;
}

.question-arrow.expanded {
  transform: rotate(180deg);
  color: #667EEA;
}

.faq-answer {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #E8ECF5;
  font-size: 26rpx;
  color: #5A6A8A;
  line-height: 1.7;
}

/* ========== 用户协议提示 ========== */
.agreement-tip {
  text-align: center;
  padding: 0 40rpx;
  margin-bottom: 32rpx;
  font-size: 22rpx;
  color: #8B9AB8;
  line-height: 1.6;
}

.agreement-tip text {
  color: #667EEA;
}

/* ========== 底部客服 ========== */
.footer-service {
  text-align: center;
  padding: 24rpx;
}

.service-text {
  font-size: 26rpx;
  color: #8B9AB8;
}

.service-link {
  font-size: 26rpx;
  color: #667EEA;
  margin-left: 8rpx;
  font-weight: 500;
}


/* ========== 支付密码弹窗 ========== */

.pay-password-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.pay-password-panel {
  width: 100%;
  background: #F2F2F7;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.pay-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  border-bottom: 2rpx solid #E5E5EA;
}

.pay-close {
  font-size: 36rpx;
  color: #8E8E93;
  width: 60rpx;
  text-align: center;
}

.pay-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2240;
  flex: 1;
  text-align: center;
}

.pay-forget {
  font-size: 28rpx;
  color: #667EEA;
  width: 120rpx;
  text-align: right;
}

.pay-amount-section {
  background: #FFFFFF;
  padding: 48rpx 32rpx 32rpx;
  text-align: center;
}

.pay-merchant {
  font-size: 28rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
  display: block;
}

.pay-merchant-name {
  font-size: 30rpx;
  color: #1A2240;
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.pay-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.pay-symbol {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A2240;
  margin-right: 4rpx;
}

.pay-money {
  font-size: 72rpx;
  font-weight: 700;
  color: #1A2240;
  line-height: 1;
}

.pay-plan-info {
  background: #FFFFFF;
  padding: 0 32rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8E8E93;
  border-bottom: 2rpx solid #E5E5EA;
}

.password-dots {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx 32rpx;
  background: #FFFFFF;
}

.dot-item {
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid #D1D1D6;
  border-radius: 12rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot-item.filled {
  border-color: #667EEA;
}

.dot-inner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #1A2240;
}

/* 数字键盘 */
.pay-keyboard {
  background: #D1D1D6;
  padding: 16rpx 12rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.keyboard-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.keyboard-row:last-child {
  margin-bottom: 0;
}

.key-btn {
  flex: 1;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 0 #A8A8AE;
}

.key-btn:active {
  background: #E5E5EA;
}

.key-btn text:first-child {
  font-size: 40rpx;
  font-weight: 500;
  color: #1A2240;
  line-height: 1.2;
}

.key-letter {
  font-size: 18rpx;
  color: #8E8E93;
  letter-spacing: 1rpx;
}

.key-empty {
  background: transparent;
  box-shadow: none;
}

.key-delete {
  background: #ADAEB2;
  box-shadow: 0 2rpx 0 #8A8B8F;
}

.key-delete:active {
  background: #8A8B8F;
}

.key-delete text {
  font-size: 36rpx !important;
  color: #FFFFFF !important;
}

/* ========== 支付成功弹窗 ========== */

.pay-success-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1001;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-success-panel {
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 60rpx 48rpx 40rpx;
  text-align: center;
  position: relative;
}

.success-icon-wrapper {
  margin-bottom: 32rpx;
}

.success-icon-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
  animation: successPop 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes successPop {
  0% { transform: scale(0); }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.success-check {
  font-size: 72rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 16rpx;
  display: block;
}

.success-amount {
  font-size: 64rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 12rpx;
  display: block;
}

.success-desc {
  font-size: 28rpx;
  color: #5A6A8A;
  margin-bottom: 32rpx;
  display: block;
}

.success-info {
  background: #F8FAFF;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 36rpx;
}

.success-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #8B9AB8;
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #667EEA;
}

.success-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

