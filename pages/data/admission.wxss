/* pages/data/admission.wxss */

.admission-page {
  padding: 24rpx;
  padding-bottom: 200rpx;
  background-color: #F8FAFF;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.search-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
  color: #8B9AB8;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A2240;
}

/* 年份切换Tab */
.year-tabs {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.year-tab {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5A6A8A;
  font-weight: 500;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.year-tab.active {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.35);
}

/* VIP提示 */
.vip-tip-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFF5F0 0%, #FFE8DE 100%);
  border: 2rpx solid #FF8A65;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.15);
}

.vip-tip-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.vip-icon {
  font-size: 52rpx;
  margin-right: 16rpx;
}

.vip-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.vip-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF8A65;
  margin-bottom: 4rpx;
}

.vip-desc {
  font-size: 24rpx;
  color: #5A6A8A;
}

.vip-arrow {
  font-size: 32rpx;
  color: #FF8A65;
  font-weight: bold;
}

/* 大学列表 */
.blur-list {
  filter: blur(10rpx);
  -webkit-filter: blur(10rpx);
  pointer-events: none;
}

.uni-card {
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.uni-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.uni-card:active::before {
  opacity: 1;
}

.uni-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.uni-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2240;
  flex: 1;
  padding-right: 16rpx;
  line-height: 1.4;
}

.uni-levels {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.level-tag {
  padding: 6rpx 14rpx;
  background: linear-gradient(135deg, rgba(255, 138, 101, 0.1) 0%, rgba(255, 183, 77, 0.1) 100%);
  color: #FF8A65;
  font-size: 20rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

/* 分数进度条 */
.score-progress {
  margin-bottom: 20rpx;
}

.score-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.score-progress-label {
  font-size: 26rpx;
  color: #5A6A8A;
  font-weight: 500;
}

.score-progress-value {
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.score-progress-bar {
  height: 16rpx;
  background: linear-gradient(90deg, #F0F2FA 0%, #E8EBF5 100%);
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.score-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667EEA 0%, #764BA2 100%);
  border-radius: 8rpx;
  transition: width 0.5s ease;
  position: relative;
}

.score-progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 24rpx;
  height: 100%;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
}

/* 录取概率展示 */
.probability-section {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.probability-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.probability-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.probability-label {
  font-size: 24rpx;
  color: #5A6A8A;
  margin-bottom: 4rpx;
}

.probability-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #667EEA;
}

.probability-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 16rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 分数线趋势 */
.score-trend {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.04) 0%, rgba(118, 75, 162, 0.04) 100%);
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.trend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.trend-item:not(:last-child)::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 40rpx;
  background-color: rgba(102, 126, 234, 0.15);
}

.trend-year {
  font-size: 24rpx;
  color: #8B9AB8;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.trend-score {
  font-size: 30rpx;
  font-weight: 700;
  color: #667EEA;
}

.trend-score.up {
  color: #FF8A65;
}

.trend-score.down {
  color: #667EEA;
}

.trend-delta {
  font-size: 20rpx;
  margin-top: 4rpx;
  color: #8B9AB8;
}

.uni-footer {
  text-align: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F2FA;
}

.footer-text {
  font-size: 26rpx;
  color: #667EEA;
  font-weight: 600;
}

.list-end {
  text-align: center;
  padding: 48rpx 0;
  font-size: 26rpx;
  color: #8B9AB8;
}

/* 底部遮罩 */
.vip-mask-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(248, 250, 255, 0) 0%, #F8FAFF 30%, #F8FAFF 100%);
  z-index: 100;
}

.vip-mask-bottom .btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
  border: none;
}

.vip-mask-bottom .btn::after {
  border: none;
}
