/* pages/data/data.wxss */

.data-page {
  padding: 28rpx 24rpx 40rpx;
  background: #F8FAFF;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== VIP横幅 ==================== */
.vip-banner {
  background: linear-gradient(135deg, #FFF7F0 0%, #FFEDE0 100%);
  border: none;
  border-radius: 28rpx;
  margin-bottom: 28rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 138, 101, 0.12);
  position: relative;
  overflow: hidden;
}

.vip-banner::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(circle, rgba(255, 138, 101, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.vip-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.vip-left {
  display: flex;
  flex-direction: column;
}

.vip-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF8A65;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.vip-desc {
  font-size: 24rpx;
  color: #8B6B5A;
  font-weight: 400;
}

.vip-arrow {
  font-size: 40rpx;
  color: #FF8A65;
  font-weight: 300;
  opacity: 0.8;
}

/* ==================== 成绩概览卡片 ==================== */
.score-overview {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  position: relative;
  overflow: hidden;
}

.score-overview::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #667EEA 0%, #764BA2 50%, #FF8A65 100%);
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.overview-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2240;
  letter-spacing: 1rpx;
}

.view-detail {
  font-size: 26rpx;
  color: #667EEA;
  font-weight: 500;
}

.overview-body {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
  padding-bottom: 180rpx;
  border-bottom: 2rpx solid #F0F3FA;
}

.total-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 60rpx;
  padding: 24rpx 36rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-radius: 20rpx;
}

.score-num {
  font-size: 64rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  letter-spacing: -2rpx;
}

.score-label {
  font-size: 24rpx;
  color: #8B9AB8;
  margin-top: 10rpx;
  font-weight: 500;
}

.score-rank {
  flex: 1;
}

.rank-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.rank-value {
  font-size: 40rpx;
  font-weight: 700;
}

.rank-label {
  font-size: 24rpx;
  color: #8B9AB8;
  margin-top: 6rpx;
  font-weight: 500;
}

.text-success {
  color: #667EEA;
}

/* 科目成绩条 */
.subject-scores {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.subject-score-item {
  display: flex;
  align-items: center;
}

.subject-name {
  width: 100rpx;
  font-size: 26rpx;
  color: #5A6A8A;
  font-weight: 500;
}

.score-bar {
  flex: 1;
  height: 18rpx;
  background-color: #F0F3FA;
  border-radius: 9rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.score-fill {
  height: 100%;
  border-radius: 9rpx;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.score-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.3) 0%, transparent 100%);
  border-radius: 9rpx 9rpx 0 0;
}

.subject-score {
  width: 80rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2240;
}

/* ==================== 成绩空状态 ==================== */
.score-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 32rpx 48rpx;
  margin-bottom: 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  position: relative;
  overflow: hidden;
}

.score-empty::before {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 200rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #667EEA 0%, #764BA2 100%);
  border-radius: 0 0 6rpx 6rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(102, 126, 234, 0.2));
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8B9AB8;
  margin-bottom: 32rpx;
  font-weight: 400;
}

/* ==================== 功能模块 ==================== */
.module-section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  position: relative;
  letter-spacing: 1rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  border-radius: 3rpx;
}

.module-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.module-card {
  display: flex;
  align-items: center;
  padding: 28rpx 28rpx;
  margin-bottom: 0;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
}

.module-card::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  opacity: 0;
  transition: opacity 0.2s ease;
}

.module-card:active::after {
  opacity: 1;
}

.module-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.12);
}

.module-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.1);
}

.vip-tag {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  font-size: 18rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FF8A65 100%);
  color: #FFFFFF;
  padding: 3rpx 10rpx;
  border-radius: 10rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(255, 138, 101, 0.3);
  letter-spacing: 1rpx;
}

.module-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.module-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.module-desc {
  font-size: 24rpx;
  color: #8B9AB8;
  font-weight: 400;
  line-height: 1.4;
}

.module-arrow {
  font-size: 36rpx;
  color: #C4CCE0;
  font-weight: 300;
  margin-left: 12rpx;
}

/* ==================== 快捷入口 ==================== */
.quick-grid {
  display: flex;
  gap: 20rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 16rpx 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  position: relative;
  transition: transform 0.2s ease;
}

.quick-item:active {
  transform: scale(0.96);
}

.quick-icon {
  font-size: 52rpx;
  margin-bottom: 16rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 22rpx;
}

.quick-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 6rpx;
  text-align: center;
  letter-spacing: 0.5rpx;
}

.quick-desc {
  font-size: 22rpx;
  color: #8B9AB8;
  text-align: center;
  font-weight: 400;
  line-height: 1.3;
}

.quick-vip {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 18rpx;
  color: #FF8A65;
  background: linear-gradient(135deg, #FFF7F0 0%, #FFEDE0 100%);
  padding: 3rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
