<!--pages/data/data.wxml-->
<view class="data-page container">
  <!-- 会员提示 -->
  <view class="vip-banner card" wx:if="{{!isMember}}" bindtap="openMember">
    <view class="vip-content">
      <view class="vip-left">
        <text class="vip-title">👑 开通会员</text>
        <text class="vip-desc">解锁历年分数线、职业前景等更多数据</text>
      </view>
      <text class="vip-arrow">›</text>
    </view>
  </view>

  <!-- 成绩概览卡片 -->
  <view class="score-overview card" wx:if="{{hasScoreData}}">
    <view class="overview-header">
      <text class="overview-title">📊 成绩概览</text>
      <text class="view-detail" bindtap="addScore">管理 ›</text>
    </view>
    <view class="overview-body">
      <view class="total-score">
        <text class="score-num">{{latestScore.total}}</text>
        <text class="score-label">总分</text>
      </view>
      <view class="score-rank">
        <view class="rank-item">
          <text class="rank-value text-success">{{latestScore.rankPercent || '25'}}%</text>
          <text class="rank-label">百分位</text>
        </view>
      </view>
    </view>
    <view class="subject-scores">
      <view class="subject-score-item" wx:for="{{latestScore.subjects}}" wx:key="name">
        <text class="subject-name">{{item.name}}</text>
        <view class="score-bar">
          <view class="score-fill" style="width: {{item.score}}%; background: {{item.score >= 80 ? '#52C41A' : item.score >= 60 ? '#FF8C42' : '#FF4D4F'}}"></view>
        </view>
        <text class="subject-score">{{item.score}}</text>
      </view>
    </view>
  </view>

  <!-- 无成绩时的引导 -->
  <view class="score-empty card" wx:else bindtap="addScore">
    <view class="empty-icon">📝</view>
    <text class="empty-title">还没有录入成绩</text>
    <text class="empty-desc">录入各科成绩，分析你的优势科目</text>
    <button class="btn btn-primary btn-small">立即录入</button>
  </view>

  <!-- 功能模块 -->
  <view class="module-section">
    <view class="section-title">数据工具</view>
    <view class="module-list">
      <view 
        class="module-card card"
        wx:for="{{modules}}"
        wx:key="id"
        data-module="{{item}}"
        bindtap="goToModule"
      >
        <view class="module-icon" style="background-color: {{item.color}}20; color: {{item.color}}">
          <text>{{item.icon}}</text>
          <text wx:if="{{item.isVip}}" class="vip-tag">会员</text>
        </view>
        <view class="module-info">
          <text class="module-name">{{item.name}}</text>
          <text class="module-desc">{{item.desc}}</text>
        </view>
        <text class="module-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 更多功能 -->
  <view class="module-section">
    <view class="section-title">更多服务</view>
    <view class="quick-grid">
      <view 
        class="quick-item card"
        wx:for="{{quickEntries}}"
        wx:key="name"
        bindtap="openMember"
      >
        <view class="quick-icon">{{item.icon}}</view>
        <text class="quick-name">{{item.name}}</text>
        <text class="quick-desc">{{item.desc}}</text>
        <view class="quick-vip" wx:if="{{item.isVip}}">会员专属</view>
      </view>
    </view>
  </view>
</view>
