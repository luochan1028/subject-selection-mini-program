/* pages/mine/feedback.wxss */

.feedback-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 120rpx;
  background-color: #F8FAFF;
  box-sizing: border-box;
}

/* 区块标题 */
.feedback-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8B9AB8;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.section-optional {
  font-size: 22rpx;
  color: #B0BCD4;
  font-weight: 400;
}

/* 卡片通用样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

/* 反馈类型选择 */
.type-list {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  min-width: calc(50% - 10rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx 16rpx;
  background-color: #F8FAFF;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
  box-sizing: border-box;
}

.type-item:active {
  transform: scale(0.96);
}

.type-item.active {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-color: #667EEA;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-name {
  font-size: 26rpx;
  color: #5A6A8A;
  font-weight: 500;
}

.type-item.active .type-name {
  color: #667EEA;
  font-weight: 600;
}

/* 反馈内容输入 */
.content-card {
  padding: 28rpx;
  position: relative;
}

.content-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #1A2240;
  line-height: 1.6;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: #B0BCD4;
  font-size: 26rpx;
}

.content-count {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F0F2F8;
}

.content-count text {
  font-size: 24rpx;
  color: #8B9AB8;
}

.content-count .count-limit {
  color: #FF6B6B;
  font-weight: 600;
}

.count-max {
  color: #B0BCD4;
}

/* 联系方式 */
.contact-card {
  padding: 8rpx 28rpx;
}

.contact-input {
  height: 96rpx;
  font-size: 28rpx;
  color: #1A2240;
  line-height: 96rpx;
}

.input-placeholder {
  color: #B0BCD4;
  font-size: 26rpx;
}

/* 上传图片 */
.image-card {
  padding: 28rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: calc((100% - 40rpx) / 3);
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.image-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.image-placeholder {
  background-color: #F0F2F8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 48rpx;
  opacity: 0.5;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1;
}

.image-add {
  background-color: #F8FAFF;
  border: 2rpx dashed #C4CCE0;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.image-add:active {
  background-color: #F0F2F8;
  border-color: #667EEA;
}

.add-icon {
  font-size: 48rpx;
  color: #8B9AB8;
  line-height: 1;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 22rpx;
  color: #8B9AB8;
}

/* 提交按钮 */
.submit-section {
  margin: 40rpx 0;
}

.btn {
  border: none;
  outline: none;
  font-size: 30rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.25);
}

.submit-btn {
  width: 100%;
}

/* 历史反馈记录 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  padding: 28rpx;
  transition: all 0.2s ease;
}

.history-item:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.06);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.type-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  color: #667EEA;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.history-status {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.status-pending {
  background-color: rgba(255, 152, 0, 0.1);
  color: #FF9800;
}

.status-processing {
  background-color: rgba(102, 126, 234, 0.1);
  color: #667EEA;
}

.status-replied {
  background-color: rgba(102, 126, 234, 0.1);
  color: #667EEA;
}

.history-content {
  font-size: 28rpx;
  color: #1A2240;
  line-height: 1.6;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.history-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid #F0F2F8;
}

.history-time {
  font-size: 22rpx;
  color: #8B9AB8;
}

.images-count {
  font-size: 22rpx;
  color: #8B9AB8;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 26rpx;
  color: #8B9AB8;
}
