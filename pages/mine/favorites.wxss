/* pages/mine/favorites.wxss - 专业美工设计风格 */

.favorites-page {
  min-height: 100vh;
  background-color: #F8FAFF;
}

.top-tabs {
  display: flex;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.2);
  position: relative;
  overflow: hidden;
}

.top-tabs::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  position: relative;
  font-weight: 500;
  z-index: 1;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #FFFFFF;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 8rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 165, 0, 0.4);
}

.tab-content {
  padding: 24rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 180rpx 0;
}

.empty-icon {
  font-size: 140rpx;
  margin-bottom: 28rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #8B9AB8;
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.favorite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  margin-bottom: 0;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.favorite-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.06);
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 0;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-type {
  font-size: 24rpx;
  color: #8B9AB8;
}

.remove-btn {
  font-size: 26rpx;
  color: #FF8A65;
  padding: 12rpx 24rpx;
  background: rgba(255, 138, 101, 0.1);
  border-radius: 20rpx;
  font-weight: 500;
}

.remove-btn:active {
  background: rgba(255, 138, 101, 0.2);
}
