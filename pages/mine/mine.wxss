/* pages/mine/mine.wxss */

.mine-page {
  min-height: 100vh;
  background-color: #F8FAFF;
  padding-bottom: 180rpx;
}

/* 用户卡片 */
.user-card {
  position: relative;
  margin-bottom: 32rpx;
}

.user-bg {
  height: 360rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  position: relative;
  overflow: hidden;
}

.user-bg::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.user-bg::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.user-content {
  position: absolute;
  top: 100rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  background-color: #FFFFFF;
}

.avatar-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FFFFFF 0%, #F0F3FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  border: 8rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-icon {
  font-size: 64rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.member-badge {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 165, 0, 0.4);
  letter-spacing: 1rpx;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 0.5rpx;
}

.member-btn {
  padding: 14rpx 32rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #F0F3FF 100%);
  color: #667EEA;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 1rpx;
}

.member-btn.member-active {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(255, 165, 0, 0.4);
}

/* 统计数据 */
.stats-row {
  display: flex;
  align-items: center;
  margin: -80rpx 32rpx 0 32rpx;
  padding: 36rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  position: relative;
  z-index: 10;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8B9AB8;
  letter-spacing: 1rpx;
}

.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: linear-gradient(180deg, transparent 0%, #F0F3FA 20%, #F0F3FA 80%, transparent 100%);
}

/* 菜单列表 */
.menu-container {
  padding: 0 24rpx;
}

.menu-group {
  margin-bottom: 32rpx;
}

.group-title {
  font-size: 26rpx;
  color: #8B9AB8;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.menu-list {
  padding: 0;
  overflow: hidden;
  margin-bottom: 0;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  border-bottom: 2rpx solid #F0F3FA;
  position: relative;
  transition: background-color 0.2s ease;
}

.menu-item:active {
  background-color: #F8FAFF;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 16rpx;
}

.menu-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.menu-name {
  font-size: 30rpx;
  color: #1A2240;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.menu-vip {
  margin-left: 12rpx;
  padding: 3rpx 12rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 500;
  border-radius: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 165, 0, 0.3);
}

.menu-desc {
  font-size: 24rpx;
  color: #8B9AB8;
  letter-spacing: 0.5rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C5CEE0;
  font-weight: 300;
  margin-left: 12rpx;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 0 32rpx 0;
}

.version {
  font-size: 24rpx;
  color: #B8C2D6;
  letter-spacing: 1rpx;
}
