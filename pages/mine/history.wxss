/* pages/mine/history.wxss - 浏览历史页面样式 */

.history-page {
  min-height: 100vh;
  background-color: #F8FAFF;
}

/* ===== 顶部分类Tab ===== */
.top-tabs {
  display: flex;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.2);
  position: relative;
  overflow: hidden;
}

.top-tabs::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 32rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  position: relative;
  font-weight: 500;
  z-index: 1;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #FFFFFF;
  font-weight: 600;
  font-size: 30rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 56rpx;
  height: 8rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 165, 0, 0.4);
}

/* ===== 页面内容 ===== */
.page-content {
  padding: 24rpx;
  padding-bottom: 180rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0 100rpx;
}

.empty-icon-wrapper {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8B9AB8;
}

/* ===== 历史记录列表 ===== */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.history-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.06);
}

/* 类型图标 */
.item-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-university {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.12) 0%, rgba(102, 126, 234, 0.06) 100%);
}

.icon-major {
  background: linear-gradient(135deg, rgba(118, 75, 162, 0.12) 0%, rgba(118, 75, 162, 0.06) 100%);
}

.icon-article {
  background: linear-gradient(135deg, rgba(255, 165, 0, 0.12) 0%, rgba(255, 165, 0, 0.06) 100%);
}

/* 内容区域 */
.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  gap: 8rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2240;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-extra {
  font-size: 24rpx;
  color: #8B9AB8;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-time {
  font-size: 22rpx;
  color: #8B9AB8;
  flex-shrink: 0;
  background: rgba(139, 154, 184, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 删除按钮 */
.delete-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.delete-icon {
  font-size: 40rpx;
  color: #C5CFE3;
  line-height: 1;
  transition: color 0.2s ease;
}

.delete-btn:active .delete-icon {
  color: #FF8A65;
}

/* ===== 清空按钮 ===== */
.clear-wrapper {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.clear-btn {
  width: 60%;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  color: #FF8A65;
  background: #FFFFFF;
  border: 2rpx solid rgba(255, 138, 101, 0.3);
  border-radius: 42rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.clear-btn::after {
  border: none;
}

.clear-btn:active {
  background: rgba(255, 138, 101, 0.08);
  border-color: rgba(255, 138, 101, 0.5);
}
