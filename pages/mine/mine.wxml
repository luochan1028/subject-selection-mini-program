<!--pages/mine/mine.wxml-->
<view class="mine-page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-bg"></view>
    <view class="user-content">
      <block wx:if="{{userInfo}}">
        <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view class="user-info">
          <view class="user-name-row">
            <text class="user-name">{{userInfo.nickName}}</text>
            <view wx:if="{{isMember}}" class="member-badge">VIP</view>
          </view>
          <text class="user-desc" wx:if="{{isMember}}">会员有效期还剩 {{remainDays}} 天</text>
          <text class="user-desc" wx:else>普通用户 · 开通会员享更多特权</text>
        </view>
      </block>
      <block wx:else>
        <view class="avatar-placeholder" bindtap="handleLogin">
          <text class="avatar-icon">👤</text>
        </view>
        <view class="user-info" bindtap="handleLogin">
          <text class="user-name">点击登录</text>
          <text class="user-desc">登录后同步数据</text>
        </view>
      </block>

      <view class="member-btn" bindtap="openMember" wx:if="{{!isMember}}">
        <text>开通会员</text>
      </view>
      <view class="member-btn member-active" bindtap="openMember" wx:else>
        <text>会员中心</text>
      </view>
    </view>

    <!-- 统计数据 -->
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{stats.assessmentCount}}</text>
        <text class="stat-label">测评</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.scoreCount}}</text>
        <text class="stat-label">成绩</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{stats.favoriteCount}}</text>
        <text class="stat-label">收藏</text>
      </view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-container">
    <view class="menu-group" wx:for="{{menuGroups}}" wx:key="title" wx:for-index="groupIndex">
      <view class="group-title">{{item.title}}</view>
      <view class="menu-list card">
        <view 
          class="menu-item"
          wx:for="{{item.items}}"
          wx:key="name"
          wx:for-item="menuItem"
          wx:for-index="menuIndex"
          data-item="{{menuItem}}"
          bindtap="handleMenuClick"
        >
          <view class="menu-icon">{{menuItem.icon}}</view>
          <view class="menu-content">
            <view class="menu-name-row">
              <text class="menu-name">{{menuItem.name}}</text>
              <text wx:if="{{menuItem.isVip}}" class="menu-vip">会员</text>
            </view>
            <text class="menu-desc">{{menuItem.desc}}</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部版本信息 -->
  <view class="footer">
    <text class="version">高中选科助手 v1.0.0</text>
  </view>
</view>
