/* pages/mine/about.wxss - 蓝紫渐变主题 */

.about-page {
  min-height: 100vh;
  padding: 0 24rpx 48rpx;
  background-color: #F8FAFF;
  box-sizing: border-box;
}

/* 头部区域 */
.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  margin: 0 -24rpx 32rpx;
  border-radius: 0 0 48rpx 48rpx;
  position: relative;
  overflow: hidden;
}

.header-section::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-section::after {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.logo-wrapper {
  width: 140rpx;
  height: 140rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.logo-icon {
  font-size: 72rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

.app-version {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.app-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.6;
  padding: 0 24rpx;
  position: relative;
  z-index: 1;
}

/* 通用区块 */
.section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 26rpx;
  color: #8B9AB8;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.card {
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  overflow: hidden;
}

/* 功能亮点 */
.features-card {
  padding: 8rpx 0;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F0F2F8;
  transition: background-color 0.2s ease;
}

.feature-item:last-child {
  border-bottom: none;
}

.feature-item:active {
  background-color: #F8FAFF;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #8B9AB8;
}

/* 联系我们 */
.contact-card {
  padding: 8rpx 0;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F0F2F8;
  transition: background-color 0.2s ease;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-item:active {
  background-color: #F8FAFF;
}

.contact-icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.wechat-icon {
  background: linear-gradient(135deg, #07C160 0%, #10AEFF 100%);
}

.email-icon {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
}

.website-icon {
  background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 100%);
}

.contact-icon {
  font-size: 36rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 26rpx;
  color: #8B9AB8;
  margin-bottom: 6rpx;
}

.contact-value {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A2240;
}

.contact-action {
  flex-shrink: 0;
}

.action-text {
  font-size: 24rpx;
  color: #667EEA;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.arrow {
  font-size: 28rpx;
  color: #C4CCE0;
  font-weight: 300;
  transition: transform 0.3s ease;
}

.arrow.rotate {
  transform: rotate(90deg);
}

/* 链接卡片 */
.link-card {
  padding: 8rpx 0;
}

.link-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 2rpx solid #F0F2F8;
  transition: background-color 0.2s ease;
}

.link-item:last-child {
  border-bottom: none;
}

.link-item:active {
  background-color: #F8FAFF;
}

.link-left {
  display: flex;
  align-items: center;
}

.link-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.link-text {
  font-size: 28rpx;
  color: #1A2240;
  font-weight: 500;
}

/* 更新记录 */
.update-log-container {
  background-color: #F8FAFF;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #F0F2F8;
}

.update-log-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #EEF1F8;
}

.update-log-item:last-child {
  border-bottom: none;
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.log-version {
  font-size: 26rpx;
  font-weight: 600;
  color: #667EEA;
}

.log-date {
  font-size: 22rpx;
  color: #8B9AB8;
}

.log-content {
  font-size: 24rpx;
  color: #5A6A8A;
  line-height: 1.6;
}

/* 操作卡片 */
.action-card {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  transition: background-color 0.2s ease;
  background: none;
  border: none;
  font-size: inherit;
  line-height: inherit;
}

.action-item::after {
  border: none;
}

.action-item:active {
  background-color: #F8FAFF;
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-label {
  font-size: 26rpx;
  color: #1A2240;
  font-weight: 500;
}

.share-btn {
  margin: 0;
  padding: 32rpx 0;
  line-height: normal;
}

.action-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: #F0F2F8;
}

/* 页脚 */
.footer {
  display: flex;
  justify-content: center;
  padding-top: 16rpx;
}

.copyright {
  font-size: 22rpx;
  color: #B0BACF;
}
