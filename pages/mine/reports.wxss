/* pages/mine/reports.wxss - 专业美工设计风格 */

.reports-page {
  padding: 24rpx;
  background-color: #F8FAFF;
  min-height: 100vh;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 32rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 28rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8B9AB8;
}

.list-tip {
  font-size: 26rpx;
  color: #8B9AB8;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}

.report-card {
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.report-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
}

.report-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.06);
}

.report-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.report-date {
  font-size: 26rpx;
  color: #8B9AB8;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.report-match {
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.report-combo {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 24rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.report-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F2F8;
}

.view-detail {
  font-size: 26rpx;
  color: #667EEA;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.delete-btn {
  font-size: 26rpx;
  color: #FF8A65;
  font-weight: 500;
}

.delete-btn:active {
  opacity: 0.7;
}
