<!--pages/mine/history.wxml-->
<view class="history-page">
  <!-- 顶部分类Tab -->
  <view class="top-tabs">
    <view 
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.name}}
    </view>
  </view>

  <view class="page-content">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{historyList.length === 0}}">
      <view class="empty-icon-wrapper">
        <text class="empty-icon">📭</text>
      </view>
      <text class="empty-title">暂无浏览记录</text>
      <text class="empty-desc">去探索大学、专业和文章吧</text>
    </view>

    <!-- 历史记录列表 -->
    <view class="history-list" wx:else>
      <view 
        class="history-item card"
        wx:for="{{historyList}}"
        wx:key="index"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        bindtap="goToDetail"
      >
        <!-- 类型图标 -->
        <view class="item-icon icon-{{item.type}}">
          <text wx:if="{{item.type === 'university'}}">🏫</text>
          <text wx:elif="{{item.type === 'major'}}">📚</text>
          <text wx:else>📖</text>
        </view>

        <!-- 内容区域 -->
        <view class="item-content">
          <text class="item-name">{{item.name}}</text>
          <view class="item-meta">
            <text class="item-extra">{{item.extra}}</text>
            <text class="item-time">{{item.timeText}}</text>
          </view>
        </view>

        <!-- 删除按钮 -->
        <view 
          class="delete-btn" 
          catchtap="removeItem" 
          data-id="{{item.id}}" 
          data-type="{{item.type}}"
        >
          <text class="delete-icon">×</text>
        </view>
      </view>
    </view>

    <!-- 清空按钮 -->
    <view class="clear-wrapper" wx:if="{{historyList.length > 0}}">
      <button class="clear-btn" bindtap="clearAll">
        清空浏览历史
      </button>
    </view>
  </view>
</view>
