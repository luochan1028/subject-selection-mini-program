/* pages/assessment/assessment.wxss */

.assessment-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F8FAFF;
}

/* 开始页 */
.intro-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  padding-bottom: 180rpx;
  background-color: #F8FAFF;
}

.intro-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 56rpx 0;
  position: relative;
}

.intro-hero::before {
  content: '';
  position: absolute;
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  height: 600rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
  border-radius: 50%;
  filter: blur(40rpx);
  z-index: 0;
}

.hero-icon {
  font-size: 140rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
  filter: drop-shadow(0 8rpx 24rpx rgba(102, 126, 234, 0.3));
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #5A6A8A;
  position: relative;
  z-index: 1;
  letter-spacing: 1rpx;
}

.intro-content {
  flex: 1;
}

.intro-section {
  margin-bottom: 32rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 28rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 4rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.feature-item {
  display: flex;
  align-items: center;
}

.feature-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.feature-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A2240;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #5A6A8A;
  line-height: 1.5;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
}

.notice-dot {
  color: #667EEA;
  margin-right: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.notice-text {
  font-size: 26rpx;
  color: #5A6A8A;
  line-height: 1.6;
  flex: 1;
}

.intro-footer {
  margin-top: 16rpx;
}

.intro-footer .btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.35);
  letter-spacing: 4rpx;
}

.history-link {
  text-align: center;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #667EEA;
  font-weight: 500;
}

/* 答题页 */
.answering-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #F8FAFF;
}

.progress-bar {
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.06);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A2240;
}

.progress-text .current {
  font-size: 36rpx;
  color: #667EEA;
  font-weight: 700;
}

.progress-module {
  font-size: 24rpx;
  color: #667EEA;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.progress-track {
  height: 12rpx;
  background-color: #EEF1F8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667EEA 0%, #764BA2 100%);
  border-radius: 6rpx;
  transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.progress-fill::after {
  content: '';
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 20rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4));
  border-radius: 6rpx;
}

.question-area {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
}

.question-card {
  margin-bottom: 40rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.question-number {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

.question-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A2240;
  line-height: 1.7;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #E5E9F2;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.option-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 0;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.04) 0%, rgba(118, 75, 162, 0.04) 100%);
  transition: width 0.3s ease;
}

.option-item.selected {
  border: 2rpx solid transparent;
  background: linear-gradient(#FFFFFF, #FFFFFF) padding-box,
              linear-gradient(135deg, #667EEA 0%, #764BA2 100%) border-box;
  background-color: #F5F6FF;
}

.option-item.selected::before {
  width: 100%;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.06) 0%, rgba(118, 75, 162, 0.06) 100%);
}

.option-radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #D0D7E6;
  margin-right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  transition: all 0.3s ease;
}

.option-item.selected .option-radio {
  border-color: transparent;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: #667EEA;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.option-item.selected .radio-inner {
  opacity: 1;
  transform: scale(1);
  background-color: #FFFFFF;
}

.option-text {
  font-size: 28rpx;
  color: #1A2240;
  line-height: 1.6;
  flex: 1;
  position: relative;
  z-index: 1;
  font-weight: 500;
}

.answer-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(102, 126, 234, 0.06);
}

.answer-footer .btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s ease;
}

.answer-footer .btn-primary {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.answer-footer .btn-secondary {
  background-color: #F0F3FA;
  color: #5A6A8A;
}

.answer-footer .btn[disabled] {
  opacity: 0.4;
  box-shadow: none;
}
