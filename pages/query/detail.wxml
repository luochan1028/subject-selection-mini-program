<!--pages/query/detail.wxml-->
<view class="detail-page" wx:if="{{detail}}">
  <!-- 大学详情头部 -->
  <view class="detail-header" wx:if="{{type === 'university'}}">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="uni-name">{{detail.name}}</view>
      <view class="uni-tags">
        <text class="level-tag" wx:for="{{detail.level}}" wx:key="*this">{{item}}</text>
        <text class="type-tag">{{detail.type}}</text>
      </view>
      <view class="uni-location">📍 {{detail.province}}</view>
    </view>
  </view>

  <!-- 专业详情头部 -->
  <view class="detail-header major-header" wx:else>
    <view class="header-bg major-bg"></view>
    <view class="header-content">
      <view class="major-name">{{detail.name}}</view>
      <view class="major-tags">
        <text class="category-tag">{{detail.category}}</text>
        <text class="degree-tag">{{detail.degree}}</text>
        <text class="duration-tag">{{detail.duration}}年制</text>
      </view>
      <view class="major-requirements">
        <text class="req-label">选科要求：</text>
        <text class="req-subject" wx:for="{{detail.subjectRequirements}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- Tab切换 -->
  <view class="detail-tabs">
    <view 
      class="tab-item {{activeTab === 'info' ? 'active' : ''}}"
      data-tab="info"
      bindtap="switchTab"
    >
      基本信息
    </view>
    <view 
      class="tab-item {{activeTab === 'admission' ? 'active' : ''}}"
      data-tab="admission"
      bindtap="switchTab"
    >
      录取分数线
      <text wx:if="{{!isMember}}" class="lock-icon">🔒</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'career' ? 'active' : ''}}"
      data-tab="career"
      bindtap="switchTab"
    >
      职业前景
      <text wx:if="{{!isMember}}" class="lock-icon">🔒</text>
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="tab-content" wx:if="{{activeTab === 'info'}}">
    <view class="info-section card">
      <view class="section-title">📝 简介</view>
      <view class="info-text">{{detail.description}}</view>
    </view>

    <!-- 大学：招生专业 -->
    <view class="info-section card" wx:if="{{type === 'university'}}">
      <view class="section-title">
        🎓 招生专业
        <text class="section-more">共{{detail.majorCount}}+个 ›</text>
      </view>
      <view class="related-list">
        <view class="related-item" wx:for="{{relatedItems}}" wx:key="majorId">
          <text class="related-name">{{item.majorName}}</text>
          <text class="related-score">{{item.admissionScore}}分</text>
        </view>
      </view>
      <view class="more-tip" wx:if="{{!isMember && relatedItems.length >= 10}}">
        <text>开通会员查看全部专业</text>
      </view>
    </view>

    <!-- 专业：开设院校 -->
    <view class="info-section card" wx:if="{{type === 'major'}}">
      <view class="section-title">
        🏫 开设院校
        <text class="section-more">共200+所 ›</text>
      </view>
      <view class="related-list">
        <view class="related-item" wx:for="{{relatedItems}}" wx:key="universityId">
          <text class="related-name">{{item.universityName}}</text>
          <text class="related-score">{{item.admissionScore}}分</text>
        </view>
      </view>
      <view class="more-tip" wx:if="{{!isMember && relatedItems.length >= 10}}">
        <text>开通会员查看全部院校</text>
      </view>
    </view>

    <!-- 专业：就业数据 -->
    <view class="info-section card" wx:if="{{type === 'major'}}">
      <view class="section-title">💼 就业数据</view>
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value success">{{detail.employmentRate}}%</text>
          <text class="stat-label">就业率</text>
        </view>
        <view class="stat-item">
          <text class="stat-value warning">¥{{detail.avgSalary}}</text>
          <text class="stat-label">平均薪资</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">45%</text>
          <text class="stat-label">考研率</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 录取分数线 -->
  <view class="tab-content" wx:if="{{activeTab === 'admission'}}">
    <view class="card">
      <view class="section-title">📈 历年录取分数线</view>
      <view class="score-chart">
        <view class="chart-bars">
          <view class="chart-bar-item" wx:for="{{historyScores}}" wx:key="year">
            <view class="bar-wrapper">
              <view class="bar-fill" style="height: {{(item.avgScore - 500) / 2}}%;"></view>
            </view>
            <text class="bar-score">{{item.avgScore}}</text>
            <text class="bar-year">{{item.year}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">📊 详细数据</view>
      <view class="score-table">
        <view class="table-header">
          <text class="th">年份</text>
          <text class="th">最低分</text>
          <text class="th">平均分</text>
          <text class="th">录取人数</text>
        </view>
        <view class="table-row" wx:for="{{historyScores}}" wx:key="year">
          <text class="td">{{item.year}}</text>
          <text class="td">{{item.minScore}}</text>
          <text class="td">{{item.avgScore}}</text>
          <text class="td">{{item.admissionCount}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 职业前景 -->
  <view class="tab-content" wx:if="{{activeTab === 'career'}}">
    <view class="card">
      <view class="section-title">💰 薪资水平</view>
      <view class="salary-list">
        <view class="salary-item">
          <text class="salary-label">应届生起薪</text>
          <text class="salary-value">¥{{detail.avgSalary - 3000}} - ¥{{detail.avgSalary}}</text>
        </view>
        <view class="salary-item">
          <text class="salary-label">3年经验</text>
          <text class="salary-value">¥{{detail.avgSalary}} - ¥{{detail.avgSalary + 5000}}</text>
        </view>
        <view class="salary-item">
          <text class="salary-label">5-10年经验</text>
          <text class="salary-value">¥{{detail.avgSalary + 5000}} - ¥{{detail.avgSalary + 15000}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">🎯 就业方向</view>
      <view class="career-list">
        <view class="career-item">
          <text class="career-name">互联网/IT</text>
          <text class="career-percent">35%</text>
        </view>
        <view class="career-item">
          <text class="career-name">金融/银行</text>
          <text class="career-percent">20%</text>
        </view>
        <view class="career-item">
          <text class="career-name">教育/科研</text>
          <text class="career-percent">15%</text>
        </view>
        <view class="career-item">
          <text class="career-name">制造业</text>
          <text class="career-percent">12%</text>
        </view>
        <view class="career-item">
          <text class="career-name">其他</text>
          <text class="career-percent">18%</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">📈 行业发展趋势</view>
      <view class="trend-desc">
        <text>随着科技的快速发展，该专业领域人才需求持续增长。未来5年预计行业规模将增长30%以上，就业前景广阔。</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <view class="bar-item" bindtap="toggleFavorite">
      <text class="bar-icon">{{isFavorite ? '❤️' : '🤍'}}</text>
      <text class="bar-text">{{isFavorite ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="btn btn-primary bar-btn">咨询招生老师</button>
  </view>
</view>
