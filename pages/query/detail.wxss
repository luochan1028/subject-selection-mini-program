/* pages/query/detail.wxss */

.detail-page {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background-color: #F8FAFF;
}

/* 头部 */
.detail-header {
  position: relative;
  margin-bottom: 32rpx;
}

.header-bg {
  height: 320rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  position: relative;
  overflow: hidden;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, transparent 70%);
  border-radius: 50%;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -120rpx;
  left: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.header-bg.major-bg {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
}

.header-bg.major-bg::before {
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, transparent 70%);
}

.header-bg.major-bg::after {
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
}

.header-content {
  position: absolute;
  bottom: -30rpx;
  left: 28rpx;
  right: 28rpx;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.15);
}

.uni-name, .major-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.uni-tags, .major-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.level-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, rgba(255, 215, 0, 0.15) 0%, rgba(255, 165, 0, 0.15) 100%);
  color: #FF8A65;
  font-size: 22rpx;
  border-radius: 12rpx;
  font-weight: 600;
  border: 2rpx solid rgba(255, 165, 0, 0.2);
}

.type-tag, .category-tag, .degree-tag, .duration-tag {
  padding: 8rpx 20rpx;
  background-color: #F0F3FA;
  color: #5A6A8A;
  font-size: 22rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.category-tag {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  color: #667EEA;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
}

.uni-location {
  font-size: 26rpx;
  color: #8B9AB8;
  display: flex;
  align-items: center;
}

.uni-location::before {
  content: '';
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>') no-repeat center / contain;
          mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>') no-repeat center / contain;
}

.major-requirements {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F0F3FA;
  margin-top: 16rpx;
}

.req-label {
  font-size: 24rpx;
  color: #8B9AB8;
  font-weight: 500;
}

.req-subject {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.05) 100%);
  color: #667EEA;
  font-size: 24rpx;
  border-radius: 12rpx;
  font-weight: 600;
  border: 2rpx solid rgba(102, 126, 234, 0.2);
}

/* Tab */
.detail-tabs {
  display: flex;
  background-color: #FFFFFF;
  margin: 0 28rpx 28rpx;
  border-radius: 24rpx;
  padding: 12rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #8B9AB8;
  border-radius: 18rpx;
  position: relative;
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.35);
}

.lock-icon {
  font-size: 20rpx;
  margin-left: 6rpx;
}

/* 内容区 */
.tab-content {
  padding: 0 28rpx;
}

.info-section {
  margin-bottom: 28rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 4rpx;
}

.section-more {
  font-size: 26rpx;
  font-weight: 500;
  color: #667EEA;
  display: flex;
  align-items: center;
}

.section-more::after {
  content: '›';
  margin-left: 4rpx;
  font-size: 32rpx;
  line-height: 1;
}

.info-text {
  font-size: 28rpx;
  color: #5A6A8A;
  line-height: 1.8;
}

/* 基本信息网格 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.info-grid-item {
  width: calc(50% - 10rpx);
  padding: 24rpx;
  background: linear-gradient(135deg, #F8FAFF 0%, #F0F3FA 100%);
  border-radius: 20rpx;
  border: 2rpx solid #EDF1F9;
}

.info-grid-label {
  font-size: 24rpx;
  color: #8B9AB8;
  margin-bottom: 10rpx;
}

.info-grid-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A2240;
}

/* 相关列表 */
.related-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.related-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #F8FAFF 0%, #F5F7FD 100%);
  border-radius: 20rpx;
  border: 2rpx solid #EDF1F9;
  transition: all 0.2s ease;
}

.related-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A2240;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 20rpx;
}

.related-score {
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  flex-shrink: 0;
}

.more-tip {
  text-align: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #E8ECF5;
  font-size: 26rpx;
  color: #667EEA;
  font-weight: 500;
}

/* 统计行 */
.stats-row {
  display: flex;
  padding: 20rpx 0;
  background: linear-gradient(135deg, #F8FAFF 0%, #F0F3FA 100%);
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  position: relative;
}

.stat-item::after {
  content: '';
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 2rpx;
  height: 48rpx;
  background: linear-gradient(180deg, transparent 0%, #E8ECF5 50%, transparent 100%);
}

.stat-item:last-child::after {
  display: none;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 8rpx;
}

.stat-value.success {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-value.warning {
  background: linear-gradient(135deg, #FFD700 0%, #FF8A65 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.stat-label {
  font-size: 24rpx;
  color: #8B9AB8;
  font-weight: 500;
}

/* 分数线图表 */
.score-chart {
  height: 320rpx;
  padding: 24rpx 0;
  background: linear-gradient(135deg, #F8FAFF 0%, #F5F7FD 100%);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.chart-bars {
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  height: 100%;
  padding: 0 20rpx;
}

.chart-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.bar-wrapper {
  width: 56rpx;
  height: 200rpx;
  background-color: #E8ECF5;
  border-radius: 12rpx 12rpx 0 0;
  display: flex;
  align-items: flex-end;
  margin-bottom: 12rpx;
  overflow: hidden;
  position: relative;
}

.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  border-radius: 12rpx 12rpx 0 0;
  position: relative;
}

.bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 20rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.3) 0%, transparent 100%);
}

.bar-score {
  font-size: 24rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 6rpx;
}

.bar-year {
  font-size: 22rpx;
  color: #8B9AB8;
  font-weight: 500;
}

/* 数据表格 */
.score-table {
  border: 2rpx solid #EDF1F9;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #FFFFFF;
}

.table-header {
  display: flex;
  background: linear-gradient(135deg, #F8FAFF 0%, #F0F3FA 100%);
}

.th {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #5A6A8A;
}

.table-row {
  display: flex;
  border-top: 2rpx solid #F0F3FA;
  transition: background-color 0.2s ease;
}

.table-row:nth-child(even) {
  background-color: #FAFBFF;
}

.td {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #1A2240;
  font-weight: 500;
}

/* 薪资 */
.salary-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.salary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #F8FAFF 0%, #F5F7FD 100%);
  border-radius: 16rpx;
  border: 2rpx solid #EDF1F9;
}

.salary-label {
  font-size: 28rpx;
  color: #5A6A8A;
  font-weight: 500;
}

.salary-value {
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #FFD700 0%, #FF8A65 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 就业方向 */
.career-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.career-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #F8FAFF;
  border-radius: 16rpx;
  border: 2rpx solid #EDF1F9;
}

.career-name {
  font-size: 28rpx;
  color: #5A6A8A;
  font-weight: 500;
}

.career-percent {
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.trend-desc {
  font-size: 28rpx;
  color: #5A6A8A;
  line-height: 1.8;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -8rpx 32rpx rgba(102, 126, 234, 0.12);
  z-index: 100;
  border-radius: 28rpx 28rpx 0 0;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
}

.bar-icon {
  font-size: 44rpx;
  margin-bottom: 4rpx;
  color: #8B9AB8;
}

.bar-text {
  font-size: 22rpx;
  color: #8B9AB8;
  font-weight: 500;
}

.bar-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}
