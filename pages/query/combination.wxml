<!--pages/query/combination.wxml-->
<view class="combo-detail-page" wx:if="{{combination}}">
  <!-- 组合头部 -->
  <view class="combo-header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="combo-name">{{combination.name}}</view>
      <view class="combo-tags">
        <text class="combo-tag" wx:for="{{combination.subjects}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="combo-stats">
        <view class="stat-item">
          <text class="stat-value">{{combination.majorCoverage}}%</text>
          <text class="stat-label">专业覆盖率</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{combination.difficulty}}</text>
          <text class="stat-label">学习难度</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{combination.competition}}</text>
          <text class="stat-label">竞争程度</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 组合简介 -->
  <view class="section card">
    <view class="section-title">📝 组合概述</view>
    <view class="section-content">{{combination.description}}</view>
  </view>

  <!-- 优劣势分析 -->
  <view class="section card">
    <view class="section-title">⚖️ 优劣势分析</view>
    <view class="pros-cons">
      <view class="pros-box">
        <view class="box-title">✅ 优势</view>
        <view class="box-list">
          <view class="box-item">专业选择面广，可报考大部分理工科专业</view>
          <view class="box-item">未来考研、就业选择方向多</view>
          <view class="box-item">学科之间关联性强，学习方法可迁移</view>
        </view>
      </view>
      <view class="cons-box">
        <view class="box-title">⚠️ 挑战</view>
        <view class="box-list">
          <view class="box-item">学习难度较大，需要较强的逻辑思维</view>
          <view class="box-item">竞争激烈，学霸扎堆</view>
          <view class="box-item">学习负担较重，需要投入大量时间</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 可报专业大类 -->
  <view class="section card">
    <view class="section-title">
      🎓 可报专业大类
      <text class="section-count">{{combination.majors.length}}个大类</text>
    </view>
    <view class="major-category-list">
      <view 
        class="category-item {{expandedCategories[index] ? 'expanded' : ''}}"
        wx:for="{{combination.majors}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="toggleCategory"
      >
        <view class="category-header">
          <text class="category-name">{{item}}</text>
          <text class="category-arrow">›</text>
        </view>
        <view class="category-detail" wx:if="{{expandedCategories[index]}}">
          <view class="major-list {{isMember ? '' : 'blur-list'}}">
            <text 
              class="major-item" 
              wx:for="{{['专业1', '专业2', '专业3', '专业4', '专业5']}}" 
              wx:key="*this"
              wx:for-item="majorName"
              data-name="{{majorName}}"
              catchtap="viewMajor"
            >
              {{majorName}}
            </text>
          </view>
          <view class="vip-tip" wx:if="{{!isMember}}">
            <text>开通会员查看完整专业列表</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 适合人群 -->
  <view class="section card">
    <view class="section-title">👤 适合人群</view>
    <view class="suitable-list">
      <view class="suitable-item">
        <text class="suitable-icon">✓</text>
        <text class="suitable-text">理科成绩优秀，逻辑思维能力强</text>
      </view>
      <view class="suitable-item">
        <text class="suitable-icon">✓</text>
        <text class="suitable-text">对理工科专业感兴趣</text>
      </view>
      <view class="suitable-item">
        <text class="suitable-icon">✓</text>
        <text class="suitable-text">动手能力强，喜欢做实验</text>
      </view>
      <view class="suitable-item">
        <text class="suitable-icon">✓</text>
        <text class="suitable-text">目标是985/211等顶尖院校</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-actions">
    <button class="btn btn-outline" bindtap="startAssessment">测测适合我吗</button>
    <button class="btn btn-primary">收藏这个组合</button>
  </view>
</view>
