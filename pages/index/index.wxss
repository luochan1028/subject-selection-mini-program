/* pages/index/index.wxss | 专业美工优化版 */

/* ==================== 欢迎栏 ==================== */

.welcome-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 36rpx 0;
  position: relative;
}

.user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 5rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}

.avatar-placeholder {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background: linear-gradient(135deg, #E8EDFF 0%, #F0E8FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.15);
}

.avatar-icon {
  font-size: 52rpx;
}

.user-detail {
  display: flex;
  flex-direction: column;
}

.greeting {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #8B9AB8;
}

.member-badge {
  margin-left: 16rpx;
  padding: 6rpx 18rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 165, 0, 0.35);
}

.member-days {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFE082 0%, #FFB347 50%, #FF8A65 100%);
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(255, 138, 101, 0.35);
  position: relative;
  overflow: hidden;
}

.member-days::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
  animation: shimmer 3s ease-in-out infinite;
}

.days-num {
  font-size: 40rpx;
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.days-text {
  font-size: 24rpx;
  margin-left: 8rpx;
  position: relative;
  z-index: 1;
}

/* ==================== 测评卡片 ==================== */

.assessment-card {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.35);
}

.assessment-card::before {
  content: '';
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  top: -150rpx;
  right: -80rpx;
}

.assessment-card::after {
  content: '';
  position: absolute;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 50%;
  bottom: -80rpx;
  left: -40rpx;
}

.assessment-card .card-header {
  position: relative;
  z-index: 1;
  margin-bottom: 20rpx;
}

.assessment-card .card-title {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  padding-left: 0;
  letter-spacing: 1rpx;
}

.assessment-card .card-title::before {
  display: none;
}

.assessment-card .card-tag {
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 500;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
}

.card-desc {
  font-size: 28rpx;
  line-height: 1.7;
  opacity: 0.9;
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
}

.assessment-card .btn-primary {
  background: #FFFFFF;
  color: #667EEA;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  font-weight: 600;
  position: relative;
  z-index: 1;
}

.assessment-card .btn-primary:active {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* ==================== 测评结果卡片 ==================== */

.assessment-result-card {
  cursor: pointer;
  transition: all 0.3s ease;
}

.assessment-result-card:active {
  transform: scale(0.98);
}

.result-summary {
  display: flex;
  flex-direction: column;
}

.result-main {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.result-combo {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A2240;
  margin-right: 24rpx;
  letter-spacing: 1rpx;
}

.result-score {
  font-size: 28rpx;
  color: #667EEA;
  font-weight: 600;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

/* ==================== 会员卡片 ==================== */

.member-card {
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 50%, #FFE082 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(255, 179, 71, 0.2);
}

.member-card::before {
  content: '👑';
  position: absolute;
  font-size: 120rpx;
  right: -20rpx;
  top: -30rpx;
  opacity: 0.15;
}

.member-card-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.member-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.member-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #E65100;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.member-title::before {
  content: '✨';
  margin-right: 10rpx;
  font-size: 32rpx;
}

.member-desc {
  font-size: 26rpx;
  color: #FF8F00;
  line-height: 1.5;
  opacity: 0.85;
}

.member-right {
  display: flex;
  align-items: baseline;
}

.member-price {
  font-size: 48rpx;
  font-weight: 700;
  color: #E65100;
  text-shadow: 0 2rpx 4rpx rgba(255, 179, 71, 0.3);
}

.member-unit {
  font-size: 24rpx;
  color: #FF8F00;
  margin-left: 6rpx;
  font-weight: 500;
}

/* ==================== 快速功能 ==================== */

.quick-func-card .func-grid {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  transition: all 0.3s ease;
}

.func-item:active {
  transform: scale(0.95);
}

.func-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-bottom: 16rpx;
  position: relative;
  overflow: hidden;
}

.func-icon::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, transparent 50%);
  border-radius: 28rpx;
}

.func-icon-1 {
  background: linear-gradient(135deg, #E8EDFF 0%, #D4DBFF 100%);
  color: #667EEA;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.25);
}

.func-icon-2 {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  color: #FF9800;
  box-shadow: 0 8rpx 20rpx rgba(255, 152, 0, 0.25);
}

.func-icon-3 {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  color: #667EEA;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.25);
}

.func-icon-4 {
  background: linear-gradient(135deg, #FCE4EC 0%, #F8BBD9 100%);
  color: #EC407A;
  box-shadow: 0 8rpx 20rpx rgba(236, 64, 122, 0.25);
}

.func-name {
  font-size: 26rpx;
  color: #1A2240;
  font-weight: 500;
}

/* ==================== 数据统计卡片 ==================== */

.stats-card {
  display: flex;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  background: linear-gradient(135deg, #F8FAFF 0%, #F0F4FF 100%);
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  border: 2rpx solid rgba(102, 126, 234, 0.1);
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #8B9AB8;
}

/* ==================== 文章列表 ==================== */

.article-list {
  display: flex;
  flex-direction: column;
}

.article-item {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F0F3FA;
  transition: all 0.2s ease;
}

.article-item:first-child {
  padding-top: 0;
}

.article-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.article-item:active {
  opacity: 0.7;
}

.article-content {
  display: flex;
  flex-direction: column;
}

.article-title {
  font-size: 30rpx;
  color: #1A2240;
  line-height: 1.6;
  margin-bottom: 14rpx;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.article-category {
  font-size: 22rpx;
  color: #667EEA;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.article-views {
  font-size: 22rpx;
  color: #B8C2D4;
  display: flex;
  align-items: center;
}

.article-views::before {
  content: '👁';
  margin-right: 8rpx;
  font-size: 20rpx;
}

/* ==================== 查看更多 ==================== */

.view-more {
  font-size: 26rpx;
  color: #667EEA;
  display: flex;
  align-items: center;
  font-weight: 500;
}

.view-more::after {
  content: '›';
  margin-left: 6rpx;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 300;
}

/* ==================== 今日推荐横幅 ==================== */

.banner-card {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.3);
}

.banner-card::before {
  content: '📚';
  position: absolute;
  font-size: 140rpx;
  right: -10rpx;
  bottom: -40rpx;
  opacity: 0.15;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.6;
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}

.banner-btn {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  color: #FFFFFF;
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.banner-btn::after {
  content: '→';
  margin-left: 10rpx;
}
