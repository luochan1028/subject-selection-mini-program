/* pages/knowledge/list.wxss - 专业美工设计风格 */

.knowledge-page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background-color: #F8FAFF;
}

/* 搜索栏 */
.search-section {
  padding: 32rpx 28rpx 24rpx;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  position: relative;
  overflow: hidden;
}

.search-section::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  border-radius: 50%;
}

.search-section::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255,138,101,0.2) 0%, transparent 70%);
  border-radius: 50%;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 28rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #8B9AB8;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A2240;
}

.search-input::placeholder {
  color: #8B9AB8;
}

/* 分类滚动 */
.category-scroll {
  white-space: nowrap;
  padding: 24rpx 28rpx 20rpx;
  background-color: #F8FAFF;
  position: sticky;
  top: 0;
  z-index: 10;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
}

.category-item {
  display: inline-block;
  padding: 14rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #5A6A8A;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.06);
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
  transform: translateY(-1rpx);
}

/* 文章列表 */
.article-list {
  padding: 8rpx 28rpx 0;
}

.article-card {
  margin-bottom: 24rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.article-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.06);
}

.article-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.article-category {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  color: #667EEA;
  font-size: 22rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.vip-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 16rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 165, 0, 0.3);
}

.article-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2240;
  line-height: 1.5;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-summary {
  font-size: 26rpx;
  color: #5A6A8A;
  line-height: 1.6;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.article-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F2F8;
}

.article-meta {
  display: flex;
  gap: 28rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #8B9AB8;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.read-more {
  font-size: 26rpx;
  color: #667EEA;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #8B9AB8;
}
