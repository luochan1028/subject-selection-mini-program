/* pages/knowledge/detail.wxss - 专业美工设计风格 */

.detail-page {
  min-height: 100vh;
  padding-bottom: 200rpx;
  background-color: #F8FAFF;
}

/* 文章头部 */
.article-header {
  padding: 36rpx 32rpx 32rpx;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  position: relative;
  overflow: hidden;
}

.article-header::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.12) 0%, transparent 70%);
  border-radius: 50%;
}

.article-header::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -30rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(255,138,101,0.18) 0%, transparent 70%);
  border-radius: 50%;
}

.article-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.vip-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 16rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 165, 0, 0.35);
}

.article-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.45;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx;
  position: relative;
  z-index: 1;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 文章内容 */
.article-content {
  padding: 36rpx 32rpx;
  font-size: 30rpx;
  color: #1A2240;
  line-height: 1.9;
  position: relative;
  background-color: #FFFFFF;
  margin: 24rpx 24rpx 0;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
}

.article-content ::v-deep h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A2240;
  margin-top: 48rpx;
  margin-bottom: 24rpx;
  position: relative;
  padding-left: 20rpx;
}

.article-content ::v-deep h2::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #667EEA 0%, #764BA2 100%);
  border-radius: 4rpx;
}

.article-content ::v-deep h3 {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A2240;
  margin-top: 36rpx;
  margin-bottom: 20rpx;
}

.article-content ::v-deep p {
  margin-bottom: 28rpx;
  text-indent: 2em;
  color: #1A2240;
}

.article-content ::v-deep ul,
.article-content ::v-deep ol {
  padding-left: 48rpx;
  margin-bottom: 28rpx;
}

.article-content ::v-deep li {
  margin-bottom: 16rpx;
  color: #5A6A8A;
}

.article-content ::v-deep strong {
  font-weight: 600;
  color: #667EEA;
}

.article-content.blur-content {
  filter: blur(20rpx);
  -webkit-filter: blur(20rpx);
  max-height: 800rpx;
  overflow: hidden;
}

/* 会员遮罩 */
.vip-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.95) 100%);
  z-index: 10;
  border-radius: 28rpx;
}

.mask-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 48rpx 40rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(102, 126, 234, 0.15);
}

.mask-icon {
  font-size: 88rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.mask-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2240;
  margin-bottom: 16rpx;
}

.mask-desc {
  font-size: 26rpx;
  color: #5A6A8A;
  margin-bottom: 36rpx;
  line-height: 1.6;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #FFFFFF;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(102, 126, 234, 0.08);
  z-index: 100;
  border-radius: 28rpx 28rpx 0 0;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  position: relative;
}

.bar-item:active {
  opacity: 0.7;
}

.bar-icon {
  font-size: 44rpx;
  margin-bottom: 2rpx;
  color: #5A6A8A;
}

.bar-item.active .bar-icon {
  color: #667EEA;
}

.bar-text {
  font-size: 22rpx;
  color: #8B9AB8;
}

.bar-item.active .bar-text {
  color: #667EEA;
  font-weight: 500;
}
