/* ==================== 标签系统 ==================== */

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

.tag-primary {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.12) 0%, rgba(118, 75, 162, 0.12) 100%);
  color: #667EEA;
}

.tag-secondary {
  background: linear-gradient(135deg, rgba(255, 179, 71, 0.15) 0%, rgba(255, 138, 101, 0.15) 100%);
  color: #FF8A65;
}

.tag-success {
  background: linear-gradient(135deg, rgba(102, 187, 106, 0.15) 0%, rgba(67, 160, 71, 0.15) 100%);
  color: #4CAF50;
}

.tag-warning {
  background: linear-gradient(135deg, rgba(255, 152, 0, 0.15) 0%, rgba(255, 112, 67, 0.15) 100%);
  color: #FF9800;
}

.tag-danger {
  background: linear-gradient(135deg, rgba(239, 83, 80, 0.12) 0%, rgba(229, 57, 53, 0.12) 100%);
  color: #EF5350;
}

.tag-default {
  background: #F0F3FA;
  color: #8B9AB8;
}

.tag-gold {
  background: linear-gradient(135deg, #FFE082 0%, #FFB347 100%);
  color: #FFFFFF;
  font-weight: 600;
}

/* 圆角标签 */
.tag-round {
  border-radius: 24rpx;
}

/* ==================== 分割线 ==================== */

.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #E4E9F5 50%, transparent 100%);
  margin: 28rpx 0;
}

.divider-solid {
  height: 2rpx;
  background-color: #F0F3FA;
  margin: 28rpx 0;
}

.divider-dashed {
  height: 2rpx;
  background: repeating-linear-gradient(90deg, #E4E9F5 0, #E4E9F5 16rpx, transparent 16rpx, transparent 32rpx);
  margin: 28rpx 0;
}

/* ==================== 模糊遮罩 ==================== */

.blur-mask {
  position: relative;
  overflow: hidden;
}

.blur-mask::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  background: rgba(255, 255, 255, 0.55);
  z-index: 1;
}

.blur-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  text-align: center;
}

/* ==================== 空状态 ==================== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--primary-gradient-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-icon {
  font-size: 72rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #5A6A8A;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #B8C2D4;
}

/* ==================== 骨架屏 ==================== */

.skeleton {
  background: linear-gradient(90deg, #F0F3FA 25%, #E4E9F5 50%, #F0F3FA 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 12rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ==================== 会员标识 ==================== */

.member-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FF6B35 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 165, 0, 0.3);
}

.member-badge::before {
  content: '👑';
  margin-right: 8rpx;
  font-size: 22rpx;
}

.vip-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 8rpx;
  margin-right: 8rpx;
  vertical-align: middle;
  letter-spacing: 1rpx;
}

/* ==================== 头像样式 ==================== */

.avatar {
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.15);
}

.avatar-ring {
  position: relative;
}

.avatar-ring::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  right: -6rpx;
  bottom: -6rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  background: var(--primary-gradient) border-box;
  -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
}

/* ==================== 徽标 ==================== */

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 10rpx;
  background: #EF5350;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(239, 83, 80, 0.4);
}

.badge-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 16rpx;
  height: 16rpx;
  background: #EF5350;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
}

/* ==================== 动画 ==================== */

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.animate-fadeIn {
  animation: fadeIn 0.4s ease-out;
}

.animate-slideUp {
  animation: slideUp 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.animate-pulse {
  animation: pulse 2s ease-in-out infinite;
}

/* ==================== 图标容器 ==================== */

.icon-box {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 40rpx;
}

.icon-box-primary {
  background: var(--primary-gradient-soft);
  color: #667EEA;
}

.icon-box-secondary {
  background: var(--secondary-gradient-soft);
  color: #FF8A65;
}

.icon-box-success {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  color: #4CAF50;
}

.icon-box-warning {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  color: #FF9800;
}

/* ==================== 装饰元素 ==================== */

.decor-dot {
  position: absolute;
  border-radius: 50%;
  opacity: 0.5;
  filter: blur(40rpx);
  z-index: 0;
}

.decor-dot-1 {
  width: 200rpx;
  height: 200rpx;
  background: #667EEA;
  top: -100rpx;
  right: -50rpx;
}

.decor-dot-2 {
  width: 150rpx;
  height: 150rpx;
  background: #764BA2;
  bottom: -50rpx;
  left: -30rpx;
}

/* ==================== 安全区域 ==================== */

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.safe-top {
  padding-top: calc(24rpx + env(safe-area-inset-top));
}

/* ==================== 底部浮动操作栏 ==================== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 24rpx rgba(102, 126, 234, 0.08);
  z-index: 100;
}
