/* app.wxss - 全局样式 | 专业美工优化版 */

/* ==================== 设计系统 ==================== */

page {
  background: linear-gradient(180deg, #F8FAFF 0%, #F5F7FF 50%, #F0F4FF 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1A2240;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 颜色变量系统 */
:root {
  /* 主色 - 蓝紫渐变（科技感+专业感） */
  --primary-color: #667EEA;
  --primary-dark: #5568D3;
  --primary-light: #8B9FFF;
  --primary-gradient: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  --primary-gradient-soft: linear-gradient(135deg, #E8EDFF 0%, #F0E8FF 100%);
  
  /* 辅助色 - 温暖橙（活力+亲和） */
  --secondary-color: #FF8A65;
  --secondary-dark: #FF7043;
  --secondary-gradient: linear-gradient(135deg, #FFB347 0%, #FF8A65 100%);
  --secondary-gradient-soft: linear-gradient(135deg, #FFF3E0 0%, #FFE8D6 100%);
  
  /* 功能色 */
  --success-color: #4CAF50;
  --success-gradient: linear-gradient(135deg, #66BB6A 0%, #43A047 100%);
  --warning-color: #FF9800;
  --danger-color: #EF5350;
  --danger-gradient: linear-gradient(135deg, #EF5350 0%, #E53935 100%);
  
  /* 背景色阶 */
  --bg-primary: #FFFFFF;
  --bg-secondary: #F8FAFF;
  --bg-tertiary: #F0F4FF;
  --bg-card: #FFFFFF;
  
  /* 文字色阶 - 四级灰度 */
  --text-primary: #1A2240;
  --text-secondary: #5A6A8A;
  --text-tertiary: #8B9AB8;
  --text-quaternary: #B8C2D4;
  
  /* 边框/分割线 */
  --border-light: #F0F3FA;
  --border-medium: #E4E9F5;
  --border-dark: #D0D8EA;
  
  /* 阴影系统 */
  --shadow-xs: 0 2rpx 8rpx rgba(102, 126, 234, 0.06);
  --shadow-sm: 0 4rpx 16rpx rgba(102, 126, 234, 0.08);
  --shadow-md: 0 8rpx 32rpx rgba(102, 126, 234, 0.12);
  --shadow-lg: 0 16rpx 48rpx rgba(102, 126, 234, 0.16);
  --shadow-primary: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

/* ==================== 通用容器 ==================== */

.container {
  padding: 28rpx 28rpx 180rpx 28rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== 卡片系统 ==================== */

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.08);
  position: relative;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, rgba(102, 126, 234, 0.1) 50%, transparent 100%);
}

.card-glass {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.card-gradient {
  background: var(--primary-gradient);
  color: #FFFFFF;
}

.card-gradient .text-secondary {
  color: rgba(255, 255, 255, 0.8);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A2240;
  letter-spacing: 0.5rpx;
  position: relative;
  padding-left: 20rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: var(--primary-gradient);
}

.card-subtitle {
  font-size: 26rpx;
  color: #8B9AB8;
  margin-top: 6rpx;
}

/* ==================== 按钮系统 ==================== */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  line-height: 96rpx;
  letter-spacing: 2rpx;
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.btn-primary {
  background: var(--primary-gradient);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.btn-secondary {
  background: var(--secondary-gradient);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.35);
}

.btn-secondary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.25);
}

.btn-success {
  background: var(--success-gradient);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.35);
}

.btn-outline {
  background: #FFFFFF;
  color: #667EEA;
  border: 2rpx solid #667EEA;
  font-weight: 500;
}

.btn-outline:active {
  background: #F0F4FF;
}

.btn-ghost {
  background: rgba(102, 126, 234, 0.1);
  color: #667EEA;
  font-weight: 500;
}

.btn-ghost:active {
  background: rgba(102, 126, 234, 0.18);
}

.btn-block {
  width: 100%;
}

.btn-small {
  height: 68rpx;
  font-size: 26rpx;
  line-height: 68rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  letter-spacing: 1rpx;
}

.btn-mini {
  height: 52rpx;
  font-size: 24rpx;
  line-height: 52rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
}

/* ==================== 文字系统 ==================== */

.text-primary {
  color: #1A2240;
}

.text-secondary {
  color: #5A6A8A;
}

.text-tertiary {
  color: #8B9AB8;
}

.text-highlight {
  color: #667EEA;
}

.text-warning {
  color: #FF8A65;
}

.text-success {
  color: #4CAF50;
}

.text-danger {
  color: #EF5350;
}

.text-gold {
  color: #FFB347;
}

.text-bold {
  font-weight: 600;
}

.text-heavy {
  font-weight: 700;
}

.text-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 60rpx;
  color: #1A2240;
  letter-spacing: 1rpx;
}

.text-subtitle {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 50rpx;
  color: #1A2240;
}

.text-body {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #5A6A8A;
}

.text-caption {
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8B9AB8;
}

.text-mini {
  font-size: 22rpx;
  line-height: 32rpx;
  color: #B8C2D4;
}

/* 渐变文字 */
.text-gradient {
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.text-gradient-gold {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ==================== 布局工具 ==================== */

.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-start {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.flex-end {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.flex-1 {
  flex: 1;
}

.flex-wrap {
  flex-wrap: wrap;
}

.align-start {
  align-items: flex-start;
}

.align-end {
  align-items: flex-end;
}

